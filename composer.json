{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "simplysmart/tools",
    "type": "library",
    "description": "Developer toolbox for simplysmart projects and packages: SemVer release from Keep a Changelog.",
    "keywords": [
        "simplysmart",
        "tools",
        "semver",
        "changelog",
        "release"
    ],
    "homepage": "https://github.com/marcinulezalka/simply-tools",
    "license": "proprietary",
    "abandoned": "simplysmart/admiro",
    "authors": [
        {
            "name": "Marcin Ulezalka",
            "email": "marcin.ulezalka@simplysmart.pl",
            "role": "Founder"
        }
    ],
    "support": {
        "issues": "https://github.com/marcinulezalka/simply-tools/issues",
        "source": "https://github.com/marcinulezalka/simply-tools"
    },
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Simplysmart\\Tools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simplysmart\\Tools\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/simplysmart",
        "bin/version-release",
        "bin/composer-private"
    ],
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
